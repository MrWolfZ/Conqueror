<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- reference packages if this project is opened in the recipe solution, otherwise reference projects -->
    <ShouldReferencePackages Condition="'$(SolutionName)'=='Conqueror.Recipes.Messaging.TestingMiddlewares'"
      >true</ShouldReferencePackages
    >
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.2">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NSubstitute" Version="5.3.0" />
    <PackageReference Include="NUnit" Version="4.2.2" />
    <PackageReference Include="NUnit.Analyzers" Version="4.3.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>
  <ItemGroup>
    <!-- the test project defines its own message types, so it needs the source generators too -->
    <!-- conditional Conqueror project references -->
    <ProjectReference
      Include="..\..\..\..\..\Conqueror\Conqueror.csproj"
      Condition="'$(ShouldReferencePackages)'!='true'"
    />
    <ProjectReference
      Include="..\..\..\..\..\Conqueror.SourceGenerators\Conqueror.SourceGenerators.csproj"
      OutputItemType="Analyzer"
      ReferenceOutputAssembly="false"
      Condition="'$(ShouldReferencePackages)'!='true'"
    />
    <!-- conditional Conqueror package references -->
    <PackageReference Include="Conqueror" Version="0.8.2-beta.3" Condition="'$(ShouldReferencePackages)'=='true'" />
    <ProjectReference Include="..\Conqueror.Recipes.Messaging.TestingMiddlewares\Conqueror.Recipes.Messaging.TestingMiddlewares.csproj" />
  </ItemGroup>
</Project>
