<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- reference packages if this project is opened in the recipe solution, otherwise reference projects -->
        <ShouldReferencePackages Condition="'$(SolutionName)'=='Conqueror.Recipes.Messaging.MonolithToDistributed'">true</ShouldReferencePackages>
    </PropertyGroup>

    <ItemGroup>
        <!-- conditional Conqueror project references -->
        <ProjectReference Include="../../../../../../transports/http/Conqueror.Transport.Http.Server.AspNetCore/Conqueror.Transport.Http.Server.AspNetCore.csproj" Condition="'$(ShouldReferencePackages)'!='true'" />

        <!-- conditional Conqueror package references -->
        <PackageReference Include="Conqueror.Transport.Http.Server.AspNetCore" Version="0.8.2-beta.3" Condition="'$(ShouldReferencePackages)'=='true'" />

        <!-- third-party packages -->
        <PackageReference Include="Swashbuckle.AspNetCore" Version="8.1.4" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Conqueror.Recipes.Messaging.MonolithToDistributed.UserHistory.Application\Conqueror.Recipes.Messaging.MonolithToDistributed.UserHistory.Application.csproj" />
        <ProjectReference Include="..\Conqueror.Recipes.Messaging.MonolithToDistributed.UserHistory.Infrastructure\Conqueror.Recipes.Messaging.MonolithToDistributed.UserHistory.Infrastructure.csproj" />
    </ItemGroup>

</Project>
