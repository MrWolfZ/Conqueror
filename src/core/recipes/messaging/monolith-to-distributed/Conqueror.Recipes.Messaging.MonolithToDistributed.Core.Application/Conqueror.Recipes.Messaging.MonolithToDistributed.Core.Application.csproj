<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>

        <!-- reference packages if this project is opened in the recipe solution, otherwise reference projects -->
        <ShouldReferencePackages Condition="'$(SolutionName)'=='Conqueror.Recipes.Messaging.MonolithToDistributed'">true</ShouldReferencePackages>
    </PropertyGroup>

    <ItemGroup>
        <!-- conditional Conqueror project references -->
        <ProjectReference Include="../../../../Conqueror/Conqueror.csproj" Condition="'$(ShouldReferencePackages)'!='true'" />
        <ProjectReference Include="../../../../../middlewares/logging/Conqueror.Middleware.Logging/Conqueror.Middleware.Logging.csproj" Condition="'$(ShouldReferencePackages)'!='true'" />

        <!-- conditional Conqueror package references -->
        <PackageReference Include="Conqueror" Version="0.8.2-beta.3" Condition="'$(ShouldReferencePackages)'=='true'" />
        <PackageReference Include="Conqueror.Middleware.Logging" Version="0.8.2-beta.3" Condition="'$(ShouldReferencePackages)'=='true'" />
    </ItemGroup>

</Project>
